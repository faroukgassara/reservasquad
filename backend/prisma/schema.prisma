generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  phone        String  @unique
  email        String  @unique
  password     String
  tokenVersion Int     @default(0)
  status       EStatus
  imageUrl     String

  role ERole @default(USER)

  passwordResetTokens    PasswordResetToken[]
  emailActivationTokens  EmailActivationToken[]
  orders                 Order[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model EmailActivationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model Seeder {
  id   String @id @default(uuid())
  name String @unique
}

model File {
  id         String @id @default(uuid())
  fileName   String
  fileSize   String
  fileFormat String
  fileRef    String

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model FaqCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  sortOrder   Int     @default(0)
  status      EStatus @default(ACTIVE)

  faqs Faq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model Faq {
  id         String      @id @default(uuid())
  question   String
  answer     String      @db.Text
  sortOrder  Int         @default(0)
  status     EStatus     @default(ACTIVE)
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([categoryId])
}


model Testimonial {
  id          String             @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  title       String
  description String             @db.Text
  rating      Int
  status      ETestimonialStatus @default(PENDING)
  sortOrder   Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([email])
}

enum EStatus {
  ACTIVE
  INACTIVE
}

enum EFormationApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ETestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ERole {
  ADMIN
  USER
  CLIENT
}

model ProductCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  sortOrder   Int     @default(0)
  status      EStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model Product {
  id               String   @id @default(uuid())
  title            String
  description      String?  @db.Text
  price            Decimal  @db.Decimal(10, 2)
  discountedPrice  Decimal? @db.Decimal(10, 2)
  imageUrl         String?
  images           String[] @default([])
  slug             String   @unique
  badges           String[] @default([])
  materials        String[] @default([])
  sizes            String[] @default([])
  hasEngraving     Boolean  @default(false)
  featured         Boolean  @default(false)
  status           EStatus  @default(ACTIVE)

  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@index([deletedAt])
}

enum ECustomerType {
  INDIVIDUAL
  COMPANY
}

enum EQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum EInvoiceStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

model Customer {
  id         String        @id @default(uuid())
  type       ECustomerType @default(COMPANY)
  name       String
  email      String?
  phone      String?
  company    String?
  vatNumber  String?
  address    String?
  city       String?
  postalCode String?
  country    String?       @default("Tunisie")
  status     EStatus       @default(ACTIVE)

  quotes   Quote[]
  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([name])
  @@index([email])
}

model DocumentSequence {
  id         String @id @default(uuid())
  prefix     String
  year       Int
  lastNumber Int    @default(0)

  @@unique([prefix, year])
}

model Quote {
  id         String       @id @default(uuid())
  number     String       @unique
  status     EQuoteStatus @default(DRAFT)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  validUntil DateTime?
  notes      String?      @db.Text
  subtotal   Decimal      @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal      @default(0) @db.Decimal(12, 2)
  total      Decimal      @default(0) @db.Decimal(12, 2)

  lines   QuoteLine[]
  invoice Invoice?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model QuoteLine {
  id           String  @id @default(uuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder    Int     @default(0)
  label        String
  description  String? @db.Text
  quantity     Decimal @default(1) @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  taxRate      Decimal @default(19) @db.Decimal(5, 2)
  lineSubtotal Decimal @default(0) @db.Decimal(12, 2)
  lineTax      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @default(0) @db.Decimal(12, 2)

  @@index([quoteId])
}

model Invoice {
  id         String         @id @default(uuid())
  number     String         @unique
  status     EInvoiceStatus @default(DRAFT)
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  quoteId    String?        @unique
  quote      Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  issueDate  DateTime       @default(now())
  dueDate    DateTime?
  notes      String?        @db.Text
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)

  lines InvoiceLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([customerId])
  @@index([issueDate])
}

model InvoiceLine {
  id           String  @id @default(uuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder    Int     @default(0)
  label        String
  description  String? @db.Text
  quantity     Decimal @default(1) @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  taxRate      Decimal @default(19) @db.Decimal(5, 2)
  lineSubtotal Decimal @default(0) @db.Decimal(12, 2)
  lineTax      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @default(0) @db.Decimal(12, 2)

  @@index([invoiceId])
}

enum EOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EShippingMethod {
  STANDARD
  EXPRESS
  PICKUP
}

model Order {
  id     String       @id @default(uuid())
  number String       @unique
  status EOrderStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  email       String
  phone       String
  address     String
  city        String
  governorate String
  postalCode  String

  shippingMethod EShippingMethod
  shippingFee    Decimal         @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)

  lines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model OrderLine {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder    Int     @default(0)
  productId    String?
  productTitle String
  productSlug  String
  imageUrl     String?
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int     @default(1)
  material     String?
  size         String?
  engraving    String?
  lineTotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}
