generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  phone        String  @unique
  email        String  @unique
  password     String
  tokenVersion Int     @default(0)
  status       EStatus
  imageUrl     String

  role ERole @default(USER)

  passwordResetTokens   PasswordResetToken[]
  emailActivationTokens EmailActivationToken[]
  reservationsCreated   Reservation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model EmailActivationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model Seeder {
  id   String @id @default(uuid())
  name String @unique
}

model File {
  id         String @id @default(uuid())
  fileName   String
  fileSize   String
  fileFormat String
  fileRef    String

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
}

model Professor {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String? @unique
  phone     String?
  specialty String?

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName])
  @@index([deletedAt])
}

model Room {
  id           String  @id @default(uuid())
  name         String
  capacity     Int
  pricePerHour Decimal @db.Decimal(10, 2)
  imageUrl     String?

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([deletedAt])
}

model Reservation {
  id          String             @id @default(uuid())
  title       String?
  roomId      String
  room        Room               @relation(fields: [roomId], references: [id])
  professorId String?
  professor   Professor?         @relation(fields: [professorId], references: [id], onDelete: SetNull)
  startAt     DateTime
  endAt       DateTime
  price       Decimal            @default(0) @db.Decimal(10, 2)
  isPaid      Boolean            @default(false)
  status      EReservationStatus @default(CONFIRMED)
  notes       String?            @db.Text
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([professorId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([isPaid])
  @@index([createdById])
}

enum EStatus {
  ACTIVE
  INACTIVE
}

enum ERole {
  ADMIN
  USER
}

enum EReservationStatus {
  CONFIRMED
  CANCELLED
}
