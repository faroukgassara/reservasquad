generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  phone        String  @unique
  email        String  @unique
  password     String
  tokenVersion Int     @default(0)
  status       EStatus
  imageUrl     String

  role ERole @default(USER)

  passwordResetTokens   PasswordResetToken[]
  emailActivationTokens EmailActivationToken[]
  reservationsCreated   Reservation[]
  auditLogs             AuditLog[]
  posSessionsOpened     PosSession[]           @relation("PosSessionOpenedBy")
  posSessionsClosed     PosSession[]           @relation("PosSessionClosedBy")
  posOrders             PosOrder[]
  posStockEntries       PosStockEntry[]
  saleOrders            SaleOrder[]
  invoicePayments       InvoicePayment[]
  subscriptions         Subscription[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model EmailActivationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  usedAt    DateTime?
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
}

model Seeder {
  id   String @id @default(uuid())
  name String @unique
}

model File {
  id         String @id @default(uuid())
  fileName   String
  fileSize   String
  fileFormat String
  fileRef    String

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
}

model Professor {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String?  @unique
  phone        String?
  specialty    String?
  specialPrice Decimal? @db.Decimal(10, 2)

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName])
  @@index([deletedAt])
}

model Room {
  id           String  @id @default(uuid())
  name         String
  capacity     Int
  pricePerHour Decimal @db.Decimal(10, 2)
  imageUrl     String?

  reservations Reservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([deletedAt])
}

model Reservation {
  id          String             @id @default(uuid())
  title       String?
  roomId      String
  room        Room               @relation(fields: [roomId], references: [id])
  professorId String?
  professor   Professor?         @relation(fields: [professorId], references: [id], onDelete: SetNull)
  startAt     DateTime
  endAt       DateTime
  price       Decimal            @default(0) @db.Decimal(10, 2)
  isPaid      Boolean            @default(false)
  paidAt      DateTime?
  status      EReservationStatus @default(CONFIRMED)
  notes       String?            @db.Text
  seriesId    String?
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([roomId])
  @@index([professorId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([isPaid])
  @@index([paidAt])
  @@index([seriesId])
  @@index([createdById])
  @@index([deletedAt])
}

enum EStatus {
  ACTIVE
  INACTIVE
}

enum ERole {
  ADMIN
  USER
}

enum EReservationStatus {
  CONFIRMED
  CANCELLED
}

enum EIncomeLineType {
  CHARGE
  INVESTMENT
  ECOFACTURE
  FAROUK
  MAJDI
}

model DailyIncome {
  id                String      @id @default(uuid())
  date              DateTime    @db.Date
  totalIncome       Decimal     @db.Decimal(10, 2)
  savings           Decimal     @db.Decimal(10, 2)
  benefits          Decimal     @default(0) @db.Decimal(10, 2)
  savingsForCharges Decimal     @default(0) @db.Decimal(10, 2)
  notes             String?
  posSessionId      String?     @unique
  posSession        PosSession? @relation(fields: [posSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date])
  @@index([deletedAt])
}

model MonthlyCarryover {
  id     String  @id @default(uuid())
  year   Int
  month  Int
  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model IncomeLine {
  id     String          @id @default(uuid())
  date   DateTime        @db.Date
  type   EIncomeLineType
  label  String
  amount Decimal         @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date])
  @@index([type])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

model CreditClient {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  cin       String?

  credits       Credit[]
  posOrders     PosOrder[]
  saleOrders    SaleOrder[]
  invoices      Invoice[]
  subscriptions Subscription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName])
  @@index([deletedAt])
}

model Credit {
  id          String       @id @default(uuid())
  clientId    String
  client      CreditClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  amount      Decimal      @db.Decimal(10, 2)
  description String?
  productId   String?
  product     PosProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Decimal?     @db.Decimal(12, 3)

  payments      CreditPayment[]
  posPayments   PosPayment[]
  posOrderLines PosOrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([deletedAt])
}

model CreditPayment {
  id             String        @id @default(uuid())
  creditId       String
  credit         Credit        @relation(fields: [creditId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  amount         Decimal       @db.Decimal(10, 2)
  note           String?
  posOrderLineId String?
  posOrderLine   PosOrderLine? @relation(fields: [posOrderLineId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([creditId])
  @@index([posOrderLineId])
  @@index([deletedAt])
}

enum EPosProductType {
  STOCKABLE
  CONSUMABLE
}

enum EPosSessionStatus {
  OPEN
  CLOSED
}

enum EPosOrderStatus {
  PAID
  REFUND
}

enum EPosPaymentMethod {
  CASH
  BANK
  CLIENT_ACCOUNT
}

model PosCategory {
  id        String  @id @default(uuid())
  name      String
  imageUrl  String?
  sortOrder Int     @default(0)

  products PosProduct[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sortOrder])
  @@index([deletedAt])
}

model PosProduct {
  id             String          @id @default(uuid())
  name           String
  categoryId     String?
  category       PosCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageUrl       String?
  price          Decimal         @db.Decimal(12, 3)
  cost           Decimal         @default(0) @db.Decimal(12, 3)
  type           EPosProductType @default(CONSUMABLE)
  availableInPos Boolean         @default(true)
  stockQty       Decimal         @default(0) @db.Decimal(12, 3)
  barcode        String?
  reference      String?
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)

  subscriptionDuration Int?
  subscriptionUnit     ESubscriptionUnit?

  stockEntries   PosStockEntry[]
  orderLines     PosOrderLine[]
  saleOrderLines SaleOrderLine[]
  invoiceLines   InvoiceLine[]
  subscriptions  Subscription[]
  credits        Credit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([categoryId])
  @@index([barcode])
  @@index([deletedAt])
}

model PosStockEntry {
  id          String     @id @default(uuid())
  productId   String
  product     PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Decimal    @db.Decimal(12, 3)
  unitCost    Decimal    @default(0) @db.Decimal(12, 3)
  supplier    String?
  note        String?
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model PosSession {
  id           String            @id @default(uuid())
  number       Int               @unique @default(autoincrement())
  status       EPosSessionStatus @default(OPEN)
  openedById   String?
  openedBy     User?             @relation("PosSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt     DateTime          @default(now())
  openingCash  Decimal           @db.Decimal(12, 3)
  closedById   String?
  closedBy     User?             @relation("PosSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  countedCash  Decimal?          @db.Decimal(12, 3)
  expectedCash Decimal?          @db.Decimal(12, 3)
  difference   Decimal?          @db.Decimal(12, 3)
  closingNote  String?

  orders      PosOrder[]
  dailyIncome DailyIncome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
}

model PosOrder {
  id             String          @id @default(uuid())
  number         Int             @unique @default(autoincrement())
  sessionId      String
  session        PosSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  cashierId      String?
  cashier        User?           @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  creditClientId String?
  creditClient   CreditClient?   @relation(fields: [creditClientId], references: [id], onDelete: SetNull)
  status         EPosOrderStatus @default(PAID)
  refundOfId     String?
  refundOf       PosOrder?       @relation("PosOrderRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds        PosOrder[]      @relation("PosOrderRefunds")
  note           String?
  total          Decimal         @db.Decimal(12, 3)
  amountPaid     Decimal         @db.Decimal(12, 3)
  change         Decimal         @default(0) @db.Decimal(12, 3)

  lines    PosOrderLine[]
  payments PosPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([cashierId])
  @@index([creditClientId])
  @@index([status])
  @@index([refundOfId])
  @@index([createdAt])
}

model PosOrderLine {
  id              String           @id @default(uuid())
  orderId         String
  order           PosOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         PosProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  quantity        Decimal          @db.Decimal(12, 3)
  unitPrice       Decimal          @db.Decimal(12, 3)
  discountPct     Decimal          @default(0) @db.Decimal(5, 2)
  total           Decimal          @db.Decimal(12, 3)
  refundOfLineId  String?
  refundOfLine    PosOrderLine?    @relation("PosOrderLineRefunds", fields: [refundOfLineId], references: [id], onDelete: SetNull)
  refundLines     PosOrderLine[]   @relation("PosOrderLineRefunds")
  saleOrderId     String?
  saleOrder       SaleOrder?       @relation(fields: [saleOrderId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditId        String?
  credit          Credit?          @relation(fields: [creditId], references: [id], onDelete: SetNull)
  creditPayments  CreditPayment[]
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoicePayments InvoicePayment[]

  @@index([orderId])
  @@index([invoiceId])
  @@index([productId])
  @@index([refundOfLineId])
  @@index([saleOrderId])
  @@index([subscriptionId])
  @@index([creditId])
}

model PosPayment {
  id       String            @id @default(uuid())
  orderId  String
  order    PosOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method   EPosPaymentMethod
  amount   Decimal           @db.Decimal(12, 3)
  creditId String?
  credit   Credit?           @relation(fields: [creditId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([method])
  @@index([creditId])
}

enum ESaleOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  CANCELLED
}

enum EInvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum EInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EInvoicePaymentMethod {
  CASH
  BANK
  CLIENT_ACCOUNT
}

model SaleOrder {
  id            String           @id @default(uuid())
  number        Int              @unique @default(autoincrement())
  status        ESaleOrderStatus @default(DRAFT)
  clientId      String
  client        CreditClient     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  salespersonId String?
  salesperson   User?            @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  orderDate     DateTime         @default(now())
  validUntil    DateTime?        @db.Date
  confirmedAt   DateTime?
  note          String?
  untaxed       Decimal          @default(0) @db.Decimal(12, 3)
  taxTotal      Decimal          @default(0) @db.Decimal(12, 3)
  total         Decimal          @default(0) @db.Decimal(12, 3)
  amountPaid    Decimal          @default(0) @db.Decimal(12, 3)

  lines    SaleOrderLine[]
  invoices Invoice[]
  posLines PosOrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
}

model SaleOrderLine {
  id          String      @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder   @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   String?
  product     PosProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  description String?
  quantity    Decimal     @db.Decimal(12, 3)
  unitPrice   Decimal     @db.Decimal(12, 3)
  discountPct Decimal     @default(0) @db.Decimal(5, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  subtotal    Decimal     @db.Decimal(12, 3)
  taxAmount   Decimal     @db.Decimal(12, 3)
  total       Decimal     @db.Decimal(12, 3)
  sortOrder   Int         @default(0)

  @@index([saleOrderId])
  @@index([productId])
}

model Invoice {
  id                String         @id @default(uuid())
  type              EInvoiceType   @default(INVOICE)
  status            EInvoiceStatus @default(DRAFT)
  year              Int?
  sequence          Int?
  clientId          String
  client            CreditClient   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  saleOrderId       String?
  saleOrder         SaleOrder?     @relation(fields: [saleOrderId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  reversedInvoiceId String?
  reversedInvoice   Invoice?       @relation("InvoiceCreditNotes", fields: [reversedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes       Invoice[]      @relation("InvoiceCreditNotes")
  invoiceDate       DateTime       @db.Date
  dueDate           DateTime?      @db.Date
  note              String?
  untaxed           Decimal        @default(0) @db.Decimal(12, 3)
  taxTotal          Decimal        @default(0) @db.Decimal(12, 3)
  stampDuty         Decimal        @default(0) @db.Decimal(12, 3)
  total             Decimal        @default(0) @db.Decimal(12, 3)
  amountPaid        Decimal        @default(0) @db.Decimal(12, 3)
  postedAt          DateTime?

  lines         InvoiceLine[]
  payments      InvoicePayment[]
  posOrderLines PosOrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([type, year, sequence])
  @@index([clientId])
  @@index([saleOrderId])
  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceDate])
  @@index([deletedAt])
}

model InvoiceLine {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     PosProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  description String?
  quantity    Decimal     @db.Decimal(12, 3)
  unitPrice   Decimal     @db.Decimal(12, 3)
  discountPct Decimal     @default(0) @db.Decimal(5, 2)
  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  subtotal    Decimal     @db.Decimal(12, 3)
  taxAmount   Decimal     @db.Decimal(12, 3)
  total       Decimal     @db.Decimal(12, 3)
  sortOrder   Int         @default(0)

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePayment {
  id             String                @id @default(uuid())
  invoiceId      String
  invoice        Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date           DateTime              @db.Date
  method         EInvoicePaymentMethod
  amount         Decimal               @db.Decimal(12, 3)
  note           String?
  createdById    String?
  createdBy      User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  posOrderLineId String?
  posOrderLine   PosOrderLine?         @relation(fields: [posOrderLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([posOrderLineId])
}

enum ESubscriptionUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum EDiscountType {
  PERCENT
  AMOUNT
}

enum ESubscriptionStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

model Subscription {
  id             String              @id @default(uuid())
  number         Int                 @unique @default(autoincrement())
  /// Secret, unguessable id used in the member card QR code (public link).
  cardToken      String              @unique @default(uuid())
  status         ESubscriptionStatus @default(DRAFT)
  clientId       String
  client         CreditClient        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productId      String?
  product        PosProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  duration       Int
  unit           ESubscriptionUnit
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  unitPrice      Decimal             @db.Decimal(12, 3)
  discountType   EDiscountType       @default(PERCENT)
  discountPct    Decimal             @default(0) @db.Decimal(5, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 3)
  taxRate        Decimal             @default(0) @db.Decimal(5, 2)
  subtotal       Decimal             @db.Decimal(12, 3)
  taxAmount      Decimal             @db.Decimal(12, 3)
  total          Decimal             @db.Decimal(12, 3)
  amountPaid     Decimal             @default(0) @db.Decimal(12, 3)
  note           String?
  renewedFromId  String?             @unique
  renewedFrom    Subscription?       @relation("SubscriptionRenewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewal        Subscription?       @relation("SubscriptionRenewals")
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  activatedAt    DateTime?

  invoices      Invoice[]
  posOrderLines PosOrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([endDate])
  @@index([deletedAt])
}
