<!doctype html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title><%= subject %></title>
    <style>
        @media screen and (max-width: 600px) {
            .container {
                width: 100% !important;
            }

            .content {
                padding: 28px 20px !important;
            }
        }

        .cta-btn:hover {
            background-color: #1e2752 !important;
        }

        a {
            color: #253165;
        }

        .newsletter-body img {
            max-width: 100% !important;
            height: auto !important;
            border-radius: 8px;
            display: block;
            margin: 14px auto;
        }

        .newsletter-body h1 {
            color: #253165;
            font-size: 22px;
            margin: 20px 0 10px 0;
            line-height: 1.3;
        }

        .newsletter-body h2 {
            color: #253165;
            font-size: 19px;
            margin: 18px 0 8px 0;
            line-height: 1.35;
        }

        .newsletter-body h3 {
            color: #253165;
            font-size: 17px;
            margin: 16px 0 6px 0;
        }

        .newsletter-body p {
            margin: 0 0 14px 0;
            line-height: 1.7;
        }

        .newsletter-body ul, .newsletter-body ol {
            margin: 12px 0 14px 22px;
            padding: 0;
        }

        .newsletter-body li {
            margin-bottom: 6px;
        }

        .newsletter-body table {
            width: 100% !important;
            border-collapse: collapse;
            margin: 16px 0;
        }

        .newsletter-body th, .newsletter-body td {
            border: 1px solid #E5E7EB;
            padding: 9px 12px;
            text-align: left;
            font-size: 14px;
        }

        .newsletter-body th {
            background-color: #F8FAFC;
            font-weight: 700;
        }

        .newsletter-body hr {
            border: none;
            border-top: 1px solid #E5E7EB;
            margin: 22px 0;
        }

        .newsletter-body blockquote {
            border-left: 4px solid #253165;
            padding: 8px 16px;
            margin: 14px 0;
            background-color: #F8FAFC;
            color: #4B5563;
            font-style: italic;
        }

        .newsletter-body .file-link, .newsletter-body .file-attachment-card {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 18px;
            background-color: #F8FAFC;
            border: 1px solid #CBD5E1;
            border-radius: 10px;
            color: #253165 !important;
            text-decoration: none !important;
            font-weight: 600;
            margin: 8px 0;
        }
    </style>
</head>

<body style="margin:0;padding:0;background-color:#F7F8FA;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased;color:#4A4F5C;">
    <% if (preheader) { %>
        <!-- Hidden Preheader Text -->
        <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;font-size:1px;line-height:1px;">
            <%= preheader %>
        </div>
    <% } %>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
        style="background-color:#F7F8FA;padding:40px 12px;">
        <tr>
            <td align="center">
                <table class="container" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                    style="max-width:580px;">
                    <!-- Brand Logo -->
                    <tr>
                        <td style="padding-bottom:28px;" align="center">
                            <img src="cid:bibliosquad-logo" width="180"
                                alt="Biblio Squad" style="display:block;border:0;outline:none;height:auto;max-width:180px;margin:0 auto;" />
                        </td>
                    </tr>

                    <!-- Main Content Card -->
                    <tr>
                        <td class="content"
                            style="background:#FFFFFF;border-radius:16px;padding:40px 36px;box-shadow:0 10px 30px rgba(37,49,101,0.06);border:1px solid #E5E7EB;border-top:4px solid #253165;">
                            
                            <% if (categoryLabel) { %>
                                <!-- Category Pill Badge -->
                                <div style="text-align:center;margin-bottom:18px;">
                                    <span style="display:inline-block;background:#EEF2FF;color:#253165;font-size:11px;font-weight:700;padding:5px 14px;border-radius:9999px;text-transform:uppercase;letter-spacing:0.8px;border:1px solid #E0E7FF;">
                                        <%= categoryLabel %>
                                    </span>
                                </div>
                            <% } %>

                            <!-- Subject Header -->
                            <h1 style="margin:0 0 24px 0;font-size:24px;line-height:1.35;color:#253165;font-weight:700;text-align:center;">
                                <%= subject %>
                            </h1>

                            <!-- Body Content (HTML & Media Support) -->
                            <div class="newsletter-body" style="font-size:15px;line-height:1.75;color:#374151;margin-bottom:24px;word-break:break-word;">
                                <% if (typeof bodyHtml !== 'undefined' && bodyHtml) { %>
                                    <%- bodyHtml %>
                                <% } else if (typeof paragraphs !== 'undefined' && paragraphs.length) { %>
                                    <% paragraphs.forEach(function(p) { %>
                                        <p style="margin:0 0 16px 0;">
                                            <%- p %>
                                        </p>
                                    <% }); %>
                                <% } %>
                            </div>

                            <% if (ctaLabel && ctaUrl) { %>
                                <!-- Call To Action Button -->
                                <div style="text-align:center;margin:32px 0 12px 0;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;">
                                        <tr>
                                            <td align="center" style="border-radius:10px;background-color:#253165;">
                                                <a href="<%= ctaUrl %>" target="_blank" rel="noopener noreferrer" class="cta-btn"
                                                    style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:10px;background-color:#253165;box-shadow:0 4px 14px rgba(37,49,101,0.25);">
                                                    <%= ctaLabel %> &rarr;
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            <% } %>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding:28px 16px 0 16px;text-align:center;">
                            <p style="margin:0;font-size:12px;color:#9CA3AF;line-height:1.5;">
                                Vous recevez cet e-mail car vous êtes client chez <strong>Biblio Squad</strong>.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
